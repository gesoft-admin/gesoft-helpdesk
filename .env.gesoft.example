# Gesoft additions to the FreeScout environment.
#
# A separate file on purpose: upstream owns .env.example, and editing it would
# make every upstream release a conflict for the sake of a few lines. Append
# what you need from here to your own .env, which is never committed.

# --- Branding (Modules/GesoftBranding) -------------------------------------
# Everything has a neutral default, so an instance that sets none of this still
# works and simply looks unbranded.

# HELPDESK_BRAND_NAME="Your Helpdesk"
# HELPDESK_BRAND_LOGO=/brand/logo.svg
# HELPDESK_BRAND_FAVICON=/brand/favicon.svg
# HELPDESK_BRAND_URL=https://support.example.com
# HELPDESK_BRAND_BANNER=/brand/banner.svg
# HELPDESK_BRAND_STYLESHEET=/brand/brand.css
# HELPDESK_BRAND_COLOR=#1f6feb
# The chat page's title and the bubble's colour there (Modules/GesoftLiveChat)
# GESOFT_LIVE_CHAT_PAGE_TITLE="Support"
# GESOFT_LIVE_CHAT_COLOR=#1f6feb

# Where this instance's corresponding source lives. The AGPL asks that people
# using the software over a network be offered its source; this is the link the
# footer points at. Running a modified build? Point it at *your* repository.
# HELPDESK_SOURCE_URL=https://github.com/gesoft-admin/gesoft-helpdesk
# HELPDESK_SOURCE_LINK=true

# --- Remote support (Modules/GesoftRemoteSupport) ---------------------------
# The address of the helpdesk-rust service as reachable from THIS server.
# GESOFT_REMOTE_SUPPORT_API_BASE=https://helpdesk.example.com

# The service's operator token. A credential for the whole backend: it stays
# server-side and is never rendered into a page or a JSON response.
# GESOFT_REMOTE_SUPPORT_OPS_TOKEN=

# The address the CUSTOMER uses, when it differs from the one above — in a
# split-horizon deployment it usually does. Empty falls back to API_BASE.
# GESOFT_REMOTE_SUPPORT_CUSTOMER_BASE=https://helpdesk.example.com

# Seconds to wait for the backend to answer at all. Deliberately short: the
# case it covers is a backend that is down, and a long block is a bad way for
# an agent to learn that.
# GESOFT_REMOTE_SUPPORT_CONNECT_TIMEOUT=5
